FROM golang:1.27.0-alpine AS builder

RUN apk add --no-cache ca-certificates git
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /sub2api-updater ./cmd/source-updater

FROM scratch
COPY --from=builder /sub2api-updater /sub2api-updater
ENTRYPOINT ["/sub2api-updater"]
